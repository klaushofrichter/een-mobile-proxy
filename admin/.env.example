# Admin App Environment Variables
# Auto-generated from proxy/.dev.vars — run: ./scripts/generate-admin-env.sh
# Do not edit admin/.env directly; update proxy/.dev.vars and regenerate.

# EEN OAuth Client ID (required for login)
VITE_EEN_CLIENT_ID=your-een-client-id

# Admin test credentials for Playwright tests (must be an admin user)
ADMIN_TEST_USER=your-admin-email@example.com
ADMIN_TEST_PASSWORD=your-admin-password

# Non-admin test credentials (for rejection tests)
TEST_NON_ADMIN_USER=your-non-admin-email@example.com
TEST_NON_ADMIN_PASSWORD=your-non-admin-password

# GitHub repository info (optional, for version links)
VITE_GITHUB_REPO=https://github.com/your-username/een-mobile-proxy
VITE_GITHUB_BRANCH=develop
