{
  "name": "een-oauth-proxy",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "stop": "lsof -ti :8787 | xargs kill -9 2>/dev/null || echo 'Port 8787 is free'",
    "deploy": "node scripts/deploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run test/performance.test.js",
    "prepare": "cd .. && husky proxy/.husky"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.12",
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "vitest": "^3.2.0",
    "wrangler": "^4.55.0"
  }
}
