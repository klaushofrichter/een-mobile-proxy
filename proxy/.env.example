# EEN OAuth Proxy - Production Deployment Secrets
# Copy this file to .env and fill in your values
# This file is used by: npm run deploy (scripts/deploy.js)
# For local development, use .dev.vars instead (see .dev.vars.example)

# EEN OAuth Credentials
CLIENT_ID=your-een-client-id
CLIENT_SECRET=your-een-client-secret

# Admin users (comma-separated email addresses)
ADMIN_EMAILS=admin@example.com

# Allowed CORS origins (comma-separated URLs)
# For local development, localhost is automatically allowed
ALLOWED_ORIGINS=https://your-username.github.io

# Environment (development or production)
ENVIRONMENT=development
